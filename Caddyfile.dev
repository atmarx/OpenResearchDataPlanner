# Caddyfile for development (runtime build)
# Serves from /app/dist

:3000 {
    root * /app/dist

    encode gzip zstd

    handle /health {
        respond 200
    }

    # Same caching rules as the production Caddyfile — see the notes there.
    @hashed {
        path /assets/*
        file
    }
    handle @hashed {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle /assets/* {
        header Cache-Control "no-store"
        respond 404
    }
    handle {
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

}
