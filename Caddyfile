# Caddyfile for OpenResearchDataPlanner
# Serves static SPA with proper routing + proxies feedback API

:3000 {
    root * /srv

    # Enable compression
    encode gzip zstd

    # Health check endpoint
    handle /health {
        respond 200
    }

    # Proxy feedback API to sidecar service
    handle /api/* {
        reverse_proxy feedback-api:4001
    }

    # --- Optional: staff-only feedback metrics without shipping the admin key ---
    # /feedback/stats returns PII and requires the ADMIN key. By default the Support
    # Workbench has a staffer paste that key at runtime (held in sessionStorage). To
    # avoid handing the admin key to the browser at all, let Caddy hold it: gate a
    # staff-only path with basic_auth and inject the key server-side. Then point the
    # workbench at /staff-api/feedback/stats and drop the in-app key prompt.
    #
    #   handle_path /staff-api/* {
    #       basic_auth {
    #           {env.WORKBENCH_USER} {env.WORKBENCH_BCRYPT_HASH}
    #       }
    #       rewrite * /api/v1{path}
    #       reverse_proxy feedback-api:4001 {
    #           header_up X-API-Key {env.API_KEY_ADMIN}
    #       }
    #   }

    # Caching. Vite content-hashes everything under /assets, so those files can
    # be cached forever. Everything else (index.html on any deep link,
    # config.json, unhashed images) must revalidate, or a browser keeps the old
    # index.html / config after a deploy. ETags make revalidation a cheap 304.
    @hashed {
        path /assets/*
        file
    }
    handle @hashed {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # A chunk from a previous deploy is gone. Answer 404 rather than the SPA
    # fallback, so the router's preload-error handler reloads the page instead
    # of executing index.html as JavaScript — and don't let anything cache it.
    handle /assets/* {
        header Cache-Control "no-store"
        respond 404
    }

    # SPA routing: try file, then index.html
    handle {
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
